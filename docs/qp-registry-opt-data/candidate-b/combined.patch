+    fn shared_maintenance_time_can_precede_a_newly_posted_ack() {
+        let pass_started = Instant::now();
+        let posted = pass_started + Duration::from_millis(1);
+        let mut flow = FlowControl::new(4, 0, pass_started);
+        flow.mark_acked(0, posted);
+        assert!(!flow.stalled(pass_started));
+        assert_eq!(flow.due_ack(pass_started), None);
+
+        // An older clock never delays an ACK triggered by received credits.
+        flow.received_data();
+        flow.received_data();
+        assert_eq!(flow.due_ack(pass_started), Some(2));
+        flow.mark_acked(2, posted);
+        assert_eq!(flow.due_ack(posted + ACK_KEEPALIVE), Some(0));
+        assert!(flow.stalled(posted + STALL_DELAY));
+    }
