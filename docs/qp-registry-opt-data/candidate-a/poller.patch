+#[tokio::test]
+async fn moving_connections_preserves_pending_maintenance() {
+    let devices = crate::rdma::test_utils::make_rdma_devices();
+    let device = &devices.devices()[0];
+    let pool = ruapc_bufpool::BufferPoolBuilder::new(devices.clone()).build();
+    let (state, _stop) = State::create(
+        crate::Router::default(),
+        &crate::SocketPoolConfig {
+            rdma: None,
+            ..Default::default()
+        },
+    )
+    .unwrap();
+    for full_scan in [false, true] {
+        for survivor_needs_retry in [false, true] {
+            let (poller, mut poll_loop) = manual_poller(device.context());
+            let sockets = [
+                register_idle_socket(&poller, device, &pool, &state),
+                register_idle_socket(&poller, device, &pool, &state),
+                register_idle_socket(&poller, device, &pool, &state),
+            ];
+            poll_loop.drain_incoming(false);
+            poll_loop.maintain_dirty_connections(Instant::now(), false);
+            let qpns = sockets.each_ref().map(|socket| socket.queue_pair.qp_num());
+            for socket in &sockets[..2] {
+                socket.set_error();
+            }
+            if survivor_needs_retry {
+                poll_loop.conns.get_mut(&qpns[2]).unwrap().recv_deficit = 1;
+            }
+            // Queue order differs from storage order. Removing indices 1 then
+            // 0 moves the tail twice, after its queue position was compacted.
+            for qp_num in [qpns[1], qpns[2], qpns[0]] {
+                mark_dirty(&mut poll_loop, qp_num);
+            }
+            if full_scan {
+                poll_loop.maintain_connections(Instant::now(), false, false);
+            } else {
+                poll_loop.maintain_dirty_connections(Instant::now(), false);
+            }
+            assert_eq!(poll_loop.conns.len(), 1);
+            assert_eq!(poll_loop.conns.get_index_of(&qpns[2]), Some(0));
+            if survivor_needs_retry {
+                assert_eq!(poll_loop.dirty_indices, [0]);
+                assert_eq!(poll_loop.conns[&qpns[2]].dirty, NonZeroUsize::new(1));
+            } else {
+                assert!(poll_loop.dirty_indices.is_empty());
+                assert!(poll_loop.conns[&qpns[2]].dirty.is_none());
+            }
+
+            // New work must find and maintain the moved connection exactly
+            // once. Block its send window so this needs no invented CQEs.
+            assert!(matches!(
+                sockets[2].state.try_acquire(),
+                crate::rdma::SendPermit::Granted { .. }
+            ));
+            sockets[2]
+                .pending_sender
+                .try_send(pool.allocate(64).unwrap())
+                .unwrap();
+            mark_dirty(&mut poll_loop, qpns[2]);
+            mark_dirty(&mut poll_loop, qpns[2]);
+            assert_eq!(poll_loop.dirty_indices, [0]);
+            poll_loop.conns.get_mut(&qpns[2]).unwrap().recv_deficit = 0;
+            poll_loop.maintain_dirty_connections(Instant::now(), false);
+            assert_eq!(poll_loop.conns[&qpns[2]].pending_sends.len(), 1);
+            assert!(poll_loop.dirty_indices.is_empty());
+            poll_loop.shutdown_cleanup();
+        }
+    }
+}
