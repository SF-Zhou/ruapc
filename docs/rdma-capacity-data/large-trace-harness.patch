--- a/ruapc/benches/capacity_rpc_large_trace.rs
+++ b/ruapc/benches/capacity_rpc_large_trace.rs
@@ -0,0 +1,153 @@
+//! Large core capacity probe: 20,000 simultaneous stripes and round-robin echoes.
+#![forbid(unsafe_code)]
+use ruapc::rdma::{RdmaConnDirection, RdmaPathReport};
+use ruapc::{Client, Context, Endpoint, ListenMode, Router, Server, SocketPoolConfig, Transport};
+use serde_json::json;
+use std::{
+    sync::Arc,
+    time::{Duration, Instant},
+};
+
+#[ruapc::service]
+trait CapacityEcho {
+    async fn echo(&self, ctx: &Context, value: &u64) -> ruapc::Result<u64>;
+}
+struct Echo;
+impl CapacityEcho for Echo {
+    async fn echo(&self, _: &Context, value: &u64) -> ruapc::Result<u64> {
+        Ok(*value)
+    }
+}
+fn arg(name: &str, default: usize) -> usize {
+    std::env::var(name).map_or(default, |s| s.parse().unwrap())
+}
+fn healthy(report: &RdmaPathReport, direction: RdmaConnDirection) -> usize {
+    report
+        .paths
+        .iter()
+        .filter(|p| p.direction == direction && p.healthy)
+        .count()
+}
+fn memory() -> serde_json::Value {
+    let status = std::fs::read_to_string("/proc/self/status").unwrap();
+    let kb = |key: &str| {
+        status.lines().find_map(|line| {
+            line.strip_prefix(key)
+                .map(|v| v.split_whitespace().next().unwrap().parse::<u64>().unwrap())
+        })
+    };
+    json!({"rss_kib":kb("VmRSS:"), "locked_kib":kb("VmLck:")})
+}
+async fn run() {
+    let connections = arg("RUAPC_CAPACITY_CONNECTIONS", 20_000);
+    let total_ops = arg("RUAPC_CAPACITY_TOTAL_OPS", 0);
+    let cq_len = arg("RUAPC_CAPACITY_CQ_LEN", 524_288);
+    let name = std::env::var("RUAPC_BENCH_RDMA_DEVICE").unwrap_or_else(|_| "mlx5_0".into());
+    let mut config = SocketPoolConfig {
+        listen_mode: ListenMode::UNIFIED,
+        buffer_pool_memory: arg("RUAPC_CAPACITY_POOL_GIB", 2) << 30,
+        ..Default::default()
+    };
+    let rdma = config.rdma.as_mut().unwrap();
+    rdma.path.device_filter = vec![name];
+    rdma.connection.qp.max_send_wr = 64;
+    rdma.connection.qp.max_recv_wr = 64;
+    rdma.connection.recv_queue_len = arg("RUAPC_CAPACITY_RECV", 2) as u32;
+    rdma.connection.max_msg_size = 16 * 1024;
+    rdma.peers.connections_per_peer = connections as u32;
+    rdma.peers.preconnect_max_per_peer = connections as u32;
+    rdma.peers.connect_lease_ms = 300_000;
+    rdma.maintenance.interval_ms = 0;
+    rdma.polling.device_cq_len = cq_len as u32;
+    rdma.polling.poll_threads_per_device = 1;
+    let mut router = Router::default();
+    Arc::new(Echo).ruapc_export(&mut router);
+    let server = Server::create(router, &config).unwrap();
+    let addr = server.listen("127.0.0.1:0".parse().unwrap()).await.unwrap();
+    let context = Context::create(&config)
+        .unwrap()
+        .with_endpoint(Endpoint::new(Transport::RDMA, addr));
+    let client = Client {
+        timeout: Duration::from_secs(60),
+        connect_timeout: Duration::from_secs(120),
+        max_retries: 0,
+        ..Default::default()
+    };
+    let start = Instant::now();
+    let probe = client.echo(&context, &7).await;
+    let client_report = context.state.rdma_path_report().await.unwrap();
+    let server_report = server.state().rdma_path_report().await.unwrap();
+    println!(
+        "{}",
+        json!({"phase":"connected","requested_connections":connections,"cq_requested":cq_len,"setup_s":start.elapsed().as_secs_f64(),"error":probe.as_ref().err().map(|e| json!({"kind":format!("{:?}",e.kind),"message":e.to_string()})),"client":client_report,"server":server_report,"memory":memory()})
+    );
+    if let Ok(value) = probe {
+        assert_eq!(value, 7);
+        assert_eq!(
+            healthy(&client_report, RdmaConnDirection::Outbound),
+            connections
+        );
+        assert_eq!(
+            healthy(&server_report, RdmaConnDirection::Inbound),
+            connections
+        );
+        let warmup_start = Instant::now();
+        for value in 0..(connections * 2).max(1000) as u64 {
+            assert_eq!(client.echo(&context, &value).await.unwrap(), value);
+        }
+        println!(
+            "{}",
+            json!({"phase":"warmup_verified", "connections":connections, "operations":(connections * 2).max(1000), "elapsed_s":warmup_start.elapsed().as_secs_f64(), "memory":memory()})
+        );
+        for num_tasks in [64, 1024] {
+            if total_ops == 0 {
+                break;
+            }
+            let iters = total_ops / num_tasks;
+            assert!(iters > 0);
+            let start = Instant::now();
+            let mut tasks = Vec::new();
+            for task_index in 0..num_tasks {
+                let context = context.clone();
+                let client = client.clone();
+                tasks.push(tokio::spawn(async move {
+                    for i in 0..iters {
+                        let value = (task_index * iters + i) as u64;
+                        assert_eq!(client.echo(&context, &value).await.unwrap(), value);
+                    }
+                }));
+            }
+            for task in tasks {
+                task.await.unwrap();
+            }
+            let elapsed_s = start.elapsed().as_secs_f64();
+            println!(
+                "{}",
+                json!({"phase":"throughput","connections":connections,"tasks":num_tasks,"operations":num_tasks*iters,"elapsed_s":elapsed_s,"qps":(num_tasks*iters) as f64/elapsed_s})
+            );
+        }
+    }
+    drop(context);
+    let stop_start = Instant::now();
+    server.stop();
+    tokio::time::timeout(Duration::from_secs(60), server.join())
+        .await
+        .unwrap();
+    println!(
+        "{}",
+        json!({"phase":"stopped","elapsed_s":stop_start.elapsed().as_secs_f64(),"memory":memory()})
+    );
+}
+fn main() {
+    tracing_subscriber::fmt()
+        .with_max_level(tracing::Level::WARN)
+        .with_writer(std::io::stderr)
+        .with_ansi(false)
+        .init();
+    tokio::runtime::Builder::new_multi_thread()
+        .worker_threads(8)
+        .enable_all()
+        .build()
+        .unwrap()
+        .block_on(run());
+}
